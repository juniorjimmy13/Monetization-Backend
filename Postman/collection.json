      "name": "4 — MPesa Callback (STK Push)",
      "item": [
        {
          "name": "TC-17 Successful Payment Callback",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-17: Callback accepted — status 200', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "",
                  "pm.test('TC-17: Response is not an error', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.not.have.property('error');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Body\": {\n    \"stkCallback\": {\n      \"MerchantRequestID\": \"MR-uat-001\",\n      \"CheckoutRequestID\": \"ws_CO_uat_success_001\",\n      \"ResultCode\": 0,\n      \"ResultDesc\": \"The service request is processed successfully.\",\n      \"CallbackMetadata\": {\n        \"Item\": [\n          { \"Name\": \"Amount\", \"Value\": 150 },\n          { \"Name\": \"MpesaReceiptNumber\", \"Value\": \"UAT1RT61SG\" },\n          { \"Name\": \"TransactionDate\", \"Value\": 20260402120000 },\n          { \"Name\": \"PhoneNumber\", \"Value\": 254757597618 }\n        ]\n      }\n    }\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/webhooks/mpesa/callback", "host": ["{{baseUrl}}"], "path": ["api", "v1", "webhooks", "mpesa", "callback"] }
          }
        },
        {
          "name": "TC-18 Failed Payment Callback (ResultCode 1032 — cancelled)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-18: Callback for failed payment accepted — status 200', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "",
                  "pm.test('TC-18: Confirmation that cancelled payment is handled gracefully', function () {",
                  "    // The system must accept the callback body and process the failure state",
                  "    pm.expect(pm.response.code).to.be.below(500);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Body\": {\n    \"stkCallback\": {\n      \"MerchantRequestID\": \"MR-uat-002\",\n      \"CheckoutRequestID\": \"ws_CO_uat_cancelled_002\",\n      \"ResultCode\": 1032,\n      \"ResultDesc\": \"Request cancelled by user.\"\n    }\n  }\n}"
            },
