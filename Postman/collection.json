    {
      "name": "3 — Order Creation",
      "item": [
        {
          "name": "TC-13 Create Order (valid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-13: Status is 200 or 201', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test('TC-13: Response has orderId', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('orderId').or.have.property('id');",
                  "    var oid = json.orderId || json.id;",
                  "    pm.collectionVariables.set('orderId', oid);",
                  "});",
                  "",
                  "pm.test('TC-13: Order status is PENDING or CREATED', function () {",
                  "    var json = pm.response.json();",
                  "    var status = json.status || json.orderStatus;",
                  "    pm.expect(status).to.be.oneOf(['PENDING', 'CREATED', 'AWAITING_PAYMENT']);",
                  "});",
                  "",
                  "pm.test('TC-13: Correct product SKU in response', function () {",
                  "    var json = pm.response.json();",
                  "    var sku = json.productSku || (json.product && json.product.sku);",
                  "    pm.expect(sku).to.equal(pm.collectionVariables.get('productSku'));",
                  "});",
                  "",
                  "pm.test('TC-13: STK Push initiated (checkoutRequestId present)', function () {",
                  "    var json = pm.response.json();",
                  "    var crid = json.checkoutRequestId || json.mpesaCheckoutRequestId;",
                  "    if (crid) {",
                  "        pm.collectionVariables.set('checkoutRequestId', crid);",
                  "        pm.expect(crid).to.be.a('string').and.not.empty;",
                  "    } else {",
                  "        // STK push may be async; pass but note absence",
                  "        console.warn('checkoutRequestId not in order response — may be dispatched asynchronously');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
