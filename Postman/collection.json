{
  "info": {
    "_postman_id": "uat-monetization-backend-v1",
    "name": "Monetization Backend — UAT Test Suite",
    "description": "UAT test collection for the Digital Monetization Backend. Covers tenant onboarding, product lifecycle, MPesa STK Push order flow, webhook callback processing, and entitlement verification. Run against a locally running instance (http://localhost:8080) backed by a dedicated test database.\n\nPre-requisites:\n  • baseUrl = http://localhost:8080\n  • ADMIN_API_KEY set in environment\n  • API_KEY will be captured automatically after TC-01",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{API_KEY}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "ADMIN_API_KEY", "value": "sk_admin_your_secret_key" },
    { "key": "API_KEY", "value": "" },
    { "key": "tenantId", "value": "" },
    { "key": "productSku", "value": "lightning-blade-uat" },
    { "key": "orderId", "value": "" },
    { "key": "checkoutRequestId", "value": "" },
    { "key": "testUserId", "value": "uat-player-001" },
    { "key": "testPhone", "value": "254757597618" }
  ],
  "item": [
    {
      "name": "1 — Tenant Onboarding",
      "item": [
        {
          "name": "TC-01 Create Tenant (valid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-01: Status is 200 or 201', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test('TC-01: Response contains tenantId', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('tenantId');",
                  "    pm.collectionVariables.set('tenantId', json.tenantId);",
                  "});",
                  "",
                  "pm.test('TC-01: Response contains apiKey', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('apiKey');",
                  "    pm.expect(json.apiKey).to.be.a('string').and.not.empty;",
                  "    // Capture for all subsequent requests",
                  "    pm.collectionVariables.set('API_KEY', json.apiKey);",
                  "});",
                  "",
                  "pm.test('TC-01: apiKey starts with sk_live_ or sk_', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.apiKey).to.match(/^sk_/);",
                  "});",
                  "",
                  "pm.test('TC-01: Response time < 3000ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{ADMIN_API_KEY}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Epic Game Studio UAT\",\n  \"webhookUrl\": \"https://example.com/webhooks/monetization\",\n  \"webhookSecret\": \"uat_secret_abc123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/tenants", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "tenants"] }
          }
        },
        {
          "name": "TC-02 Create Tenant — missing name (negative)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-02: Status is 400 Bad Request', function () {",
                  "    pm.expect(pm.response.code).to.equal(400);",
                  "});",
                  "",
                  "pm.test('TC-02: Error body is present', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.satisfy(function(j) {",
                  "        return j.message || j.error || j.errors;",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{ADMIN_API_KEY}}", "type": "string" }]
