    {
      "name": "5 — Entitlement Verification",
      "item": [
        {
          "name": "TC-21 Query Entitlements — user has entitlement",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-21: Status is 200', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "",
                  "pm.test('TC-21: Response is an array', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('TC-21: At least one entitlement exists after payment', function () {",
                  "    var list = pm.response.json();",
                  "    pm.expect(list.length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test('TC-21: Entitlement is for the correct SKU', function () {",
                  "    var list = pm.response.json();",
                  "    var sku = pm.collectionVariables.get('productSku');",
                  "    var found = list.some(function(e) {",
                  "        return (e.productSku === sku) || (e.sku === sku) || (e.product && e.product.sku === sku);",
                  "    });",
                  "    pm.expect(found, 'Expected entitlement for SKU ' + sku).to.be.true;",
                  "});",
                  "",
                  "pm.test('TC-21: Entitlement has granted status', function () {",
                  "    var list = pm.response.json();",
                  "    var granted = list.some(function(e) {",
                  "        var s = e.status || e.entitlementStatus || 'GRANTED';",
                  "        return s === 'GRANTED' || s === 'ACTIVE';",
                  "    });",
                  "    pm.expect(granted).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/entitlements?externalUserId={{testUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "entitlements"],
              "query": [{ "key": "externalUserId", "value": "{{testUserId}}" }]
            }
          }
